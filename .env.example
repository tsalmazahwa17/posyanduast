# ==============================================================================
# POSYANDU ASTER — SUPABASE PRODUCTION ENVIRONMENT
# Salin menjadi .env.local untuk pengembangan atau masukkan ke Vercel.
# Jangan commit file yang berisi nilai asli.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE POSTGRES + PRISMA
# ------------------------------------------------------------------------------
# Supabase Dashboard > tombol Connect > Transaction pooler (port 6543).
# URL-encode password database bila mengandung @, :, /, #, %, dan karakter khusus.
DATABASE_URL="postgresql://postgres.PROJECT_REF:URL_ENCODED_DB_PASSWORD@REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"

# Supabase Dashboard > Connect > Session pooler (port 5432).
# Dipakai untuk migration, seed, dan Prisma Studio.
DIRECT_URL="postgresql://postgres.PROJECT_REF:URL_ENCODED_DB_PASSWORD@REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# ------------------------------------------------------------------------------
# 2. SUPABASE API, REALTIME, DAN STORAGE
# ------------------------------------------------------------------------------
# Supabase Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"

# Publishable key aman berada di browser. Gunakan format sb_publishable_...
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_GANTI_DENGAN_PUBLISHABLE_KEY"

# Fallback hanya untuk project lama. Jangan isi jika publishable key sudah dipakai.
# NEXT_PUBLIC_SUPABASE_ANON_KEY="legacy_anon_key"

# Secret key hanya untuk server/Vercel. JANGAN beri prefix NEXT_PUBLIC_.
SUPABASE_SECRET_KEY="sb_secret_GANTI_DENGAN_SECRET_KEY"

# Fallback project lama.
# SUPABASE_SERVICE_ROLE_KEY="legacy_service_role_key"

# Bucket public untuk aset aplikasi. Upload tetap hanya melalui API server yang terlindungi.
SUPABASE_STORAGE_BUCKET="posyandu-aster-public"
SUPABASE_PRIVATE_STORAGE_BUCKET="posyandu-aster-private"

# ------------------------------------------------------------------------------
# 3. SESSION APLIKASI
# ------------------------------------------------------------------------------
# Minimal 32 karakter acak. Contoh: openssl rand -hex 32
JWT_SECRET="GANTI_DENGAN_RANDOM_SECRET_MINIMAL_32_KARAKTER"

# Pengembangan: http://localhost:3000
# Produksi: https://domain-anda.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 4. AKUN DATA AWAL
# ------------------------------------------------------------------------------
# Ganti sebelum menjalankan npm run supabase:bootstrap.
SEED_ADMIN_NAME="Administrator"
SEED_ADMIN_EMAIL="admin@posyanduaster.id"
SEED_ADMIN_PASSWORD="GantiAdmin123!"
SEED_KADER_NAME="Kader Aster"
SEED_KADER_EMAIL="kader@posyanduaster.id"
SEED_USER_PASSWORD="GantiKader123!"

# Hanya diperlukan bila sengaja menjalankan npm run db:seed:demo pada project staging.
SEED_MASYARAKAT_PASSWORD="GantiWarga123!"

# ------------------------------------------------------------------------------
# 5. OPSIONAL — MIGRASI DARI POSTGRESQL LOKAL LAMA
# ------------------------------------------------------------------------------
# Hanya isi saat memakai: npm run supabase:bootstrap:from-local
# Contoh: postgresql://postgres:PASSWORD@localhost:5432/posyandu_aster
# OLD_DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
